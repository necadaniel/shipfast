# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.

# -----------------------------------------------------------------------------
# NextAuth (required)
# Generate a secret with: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Site URL — used for sitemap + robots.txt generation at build time
# -----------------------------------------------------------------------------
SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# MongoDB (required for accounts and magic links)
# Create a free cluster at https://cloud.mongodb.com
# -----------------------------------------------------------------------------
MONGODB_URI=

# -----------------------------------------------------------------------------
# Google OAuth (optional — sign-in with Google is skipped if unset)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# -----------------------------------------------------------------------------
GOOGLE_ID=
GOOGLE_SECRET=

# -----------------------------------------------------------------------------
# Resend (optional — magic links and transactional email are skipped if unset)
# The sending domain must be verified: https://resend.com/domains
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Stripe (optional — checkout is disabled if unset)
# Local webhooks: stripe listen --forward-to localhost:3000/api/webhook/stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs from your Stripe dashboard. These map to config.stripe.plans.
# Public because the pricing page renders them into the client bundle;
# price IDs are not secrets.
NEXT_PUBLIC_STRIPE_PRICE_STARTER=
NEXT_PUBLIC_STRIPE_PRICE_ADVANCED=
